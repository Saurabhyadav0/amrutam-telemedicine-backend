# Copy with `make env` (generates real secrets). All config is read from env vars.
ENVIRONMENT=local
LOG_LEVEL=INFO
JSON_LOGS=true

DATABASE_URL=postgresql+asyncpg://amrutam:amrutam@localhost:5432/amrutam
REDIS_URL=redis://localhost:6379/0

# {kid: secret}; the active kid signs. Add a new kid + switch JWT_ACTIVE_KID to rotate.
JWT_KEYS=
JWT_ACTIVE_KID=k1

# {version: base64(32 bytes)} for AES-256-GCM field encryption.
DATA_ENCRYPTION_KEYS=
DATA_ACTIVE_KEY_VERSION=v1
BLIND_INDEX_KEY=

# Payment gateway webhook HMAC secret (>= 32 bytes).
PAYMENT_WEBHOOK_SECRET=
# Ed25519 private seed (base64, 32 bytes) for e-prescription signatures.
PRESCRIPTION_SIGNING_KEY=
PRESCRIPTION_SIGNING_KEY_ID=rx1

CORS_ORIGINS=["http://localhost:3000"]
# Set to send traces, e.g. http://localhost:4318 (Jaeger OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=
